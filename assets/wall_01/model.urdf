<robot name="wall_01">
  <material name="paint"><color rgba="0.6 0.6 0.6 1" /></material>
  <link name="base">
    <inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="2" /><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" /></inertial>
    <visual name="wall"><origin xyz="0 0 0.03" rpy="0 0 0" /><geometry><box size="0.02 0.4 0.06" /></geometry><material name="paint" /></visual>
    <collision name="wall"><origin xyz="0 0 0.03" rpy="0 0 0" /><geometry><box size="0.02 0.4 0.06" /></geometry></collision>
  </link>
</robot>
