    <visual name="top"><origin xyz="0 0 0.005" rpy="0 0 0" /><geometry><box size="0.16 0.16 0.01" /></geometry><material name="paint" /></visual>
    <collision name="top"><origin xyz="0 0 0.005" rpy="0 0 0" /><geometry><box size="0.16 0.16 0.01" /></geometry></collision>
  </link>
</robot>
