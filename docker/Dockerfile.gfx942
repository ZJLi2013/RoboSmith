# syntax=docker/dockerfile:1.7

# RoboSmith ROCm runtime — gfx942 (MI300/MI308X, CDNA3) legacy stack.
#
# gfx942 hits an LLVM ISel segfault (exit 139) while Genesis 1.0.0 / Quadrants
# 0.8.0 compile the narrow-phase convex collision kernel during scene.build()
# (Genesis issue #2570). gfx950 (MI350) is unaffected. This image pins the
# workshop-validated old stack that compiles cleanly on gfx942:
#
#   ROCm 6.4.3 + PyTorch 2.6 + Genesis 0.4.5 (Quadrants 0.5.2)
#   + HSA_OVERRIDE_GFX_VERSION=9.4.2 (kept set, NOT unset)
#
# The current rocm7.2/Genesis-1.0.0 image (robotsmith:rocm-headless-graspgen)
# stays the gfx950/wbb3 runtime; this image is gfx942-only.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.gfx942 \
#     -t robotsmith:gfx942-rocm6.4.3-genesis0.4.5 .
ARG BASE_IMAGE=rocm/pytorch:rocm6.4.3_ubuntu24.04_py3.12_pytorch_release_2.6.0
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:99
ENV ROBOSMITH_HEADLESS=xvfb
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    cmake \
    ffmpeg \
    git \
    libgl1 \
    libgl1-mesa-dri \
    libglib2.0-0 \
    libglx-mesa0 \
    libgomp1 \
    libsm6 \
    libxext6 \
    libxrender1 \
    mesa-utils \
    ninja-build \
    pkg-config \
    rsync \
    wget \
    xauth \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

# Genesis 0.4.5 pinned at commit e807698 (fixes the cuda.bindings import that
# breaks PyPI 0.4.5 on ROCm). The numpy/scikit-image force-reinstall resolves
# the "numpy.dtype size changed" ABI mismatch that Genesis 0.4.5 triggers.
# setuptools is pinned <81 because Genesis 0.4.5 imports z3, which still relies
# on pkg_resources; setuptools>=81 dropped pkg_resources and breaks the import.
RUN python -m pip install --upgrade pip wheel "setuptools<81" \
    && python -m pip install \
      "git+https://github.com/Genesis-Embodied-AI/Genesis.git@e807698b8aa773fad3a6dfb4556889b251c30924" \
    && python -m pip install --force-reinstall "scikit-image>=0.22" "numpy==2.1.2" "setuptools<81"

WORKDIR /workspace/robotsmith

# Keep the repo install late so source edits do not force a full OS rebuild.
COPY pyproject.toml ./
COPY robotsmith ./robotsmith
COPY scripts ./scripts
COPY tests ./tests

# Install the package WITHOUT the [genesis] extra so Genesis stays at the
# gfx942-safe 0.4.5 pinned above (the extra would pull genesis-world>=0.2 ->
# 1.0.0 and reintroduce the crash). lerobot is added below; GraspGen (learned
# grasp) is enabled via the spconv_rocm layer further down.
RUN python -m pip install -e ".[dev]" \
    && python -m pip install \
      addict einops h5py hydra-core imageio meshcat networkx>=3.0 \
      omegaconf "pyglet>=1.5,!=2.1.8" PyOpenGL==3.1.5 scipy scikit-learn \
      tensorboard tensorboardx timm webdataset yapf==0.40.1 \
      yourdfpy==0.0.56

# lerobot is needed by robotsmith.sim.recorder (dataset recording in scenario
# smoke runs). Pin 0.4.4 (workshop-validated on this base) and re-pin the
# numpy/scikit-image/setuptools versions afterwards, because lerobot pulls a
# newer numpy that would otherwise reintroduce the Genesis skimage ABI break.
RUN python -m pip install "lerobot==0.4.4" \
    && python -m pip install --force-reinstall \
      "scikit-image>=0.22" "numpy==2.1.2" "setuptools<81"

# GraspGen (learned grasp) layer for gfx942.
#
# GraspGen/PointTransformerV3 ROCm compatibility (mirrors docker/Dockerfile
# §spconv and docs/quick-start.md §3):
# - Use spconv_rocm (NOT upstream spconv-cu120), built from source against this
#   image's ROCm 6.4.3 / PyTorch 2.6 toolchain.
# - Use the repo torch_scatter shim (pure-PyTorch segment_csr), NOT PyG ROCm
#   wheels which are ABI-fragile across ROCm images.
# - GraspGen checkpoints must be converted to the spconv_rocm 3D weight layout
#   via scripts/setup/_convert_spconv_ckpt.py (produces *_rocm.pth) and the
#   config must point at the *_rocm.pth files.
# numpy/scikit-image/setuptools are re-pinned afterwards because the
# diffusers/transformers/huggingface-hub deps pull a newer numpy that would
# otherwise reintroduce the Genesis 0.4.5 skimage ABI break.
RUN python -m pip install --no-cache-dir \
      "git+https://github.com/ZJLi2013/spconv_rocm.git@rocm" \
    && python -m pip install --no-cache-dir \
      transformers==4.45.2 tensordict diffusers==0.11.1 \
      huggingface-hub==0.25.2 sharedarray \
    && if [ -f scripts/setup/_install_scatter_shim.py ]; then \
         python scripts/setup/_install_scatter_shim.py; \
       fi \
    && python -m pip install --force-reinstall \
      "scikit-image>=0.22" "numpy==2.1.2" "setuptools<81"

RUN cat >/usr/local/bin/robotsmith-headless <<'EOF' \
    && chmod +x /usr/local/bin/robotsmith-headless
#!/usr/bin/env bash
set -euo pipefail

# gfx942 LLVM codegen bypass: Genesis 0.4.5 compiles its collision kernels
# cleanly only when the ISA target is the clean "9.4.2" string. Keep this set
# (the rocm7.2/gfx950 image deliberately unsets it).
export HSA_OVERRIDE_GFX_VERSION="${HSA_OVERRIDE_GFX_VERSION:-9.4.2}"

export DISPLAY="${DISPLAY:-:99}"

if ! pgrep -f "Xvfb ${DISPLAY}" >/dev/null 2>&1; then
  Xvfb "${DISPLAY}" -screen 0 "${XVFB_SCREEN:-1280x1024x24}" -ac +extension GLX +render -noreset >/tmp/xvfb.log 2>&1 &
  sleep 2
fi

exec "$@"
EOF

ENTRYPOINT ["robotsmith-headless"]
CMD ["bash"]
